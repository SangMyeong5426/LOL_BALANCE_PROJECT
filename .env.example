# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.
#   cp .env.example .env

# 패치 노트 구조화와 규칙 추출에 쓴다.
# 데이터 수집과 통계 베이스라인은 이 값이 없어도 돌아간다.
ANTHROPIC_API_KEY=

# 패치 노트 구조화와 규칙 추출에 쓸 모델. 에이전트는 아래 LOL_BALANCE_AGENT_MODEL 을 쓴다.
LOL_BALANCE_LLM_MODEL=claude-opus-5

# 학습·평가 분할과 표본 추출의 기본 시드. 같은 시드 → 같은 분할.
LOL_BALANCE_SEED=20260824

# 에이전트(B8) 모델 — `제공자:모델`. 기본은 로컬(Ollama)이라 키가 필요 없다.
# 비워 두면 ollama:qwen3.5:9b 다. 근거는 docs/adr/0009.
LOL_BALANCE_AGENT_MODEL=

# Riot 개인 키(Personal API Key). **선택** — 직접 집계(scripts/fetch-riot)에만 쓴다.
# 없어도 기존 결과는 전부 나온다. 24시간마다 꺼지는 개발 키가 아니라 개인 키를
# 넣는다. 근거는 docs/adr/0010.
RIOT_API_KEY=
