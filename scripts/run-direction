#!/usr/bin/env python3
"""방향 예측 arm 을 돌린다 — 조정된다면 너프인가 버프인가.

    ./scripts/run-direction [--split 15_13]

**대상 예측과 다른 과제다.** 「조정될까」는 U자라 승률로 줄 세우면 무작위보다
못한데, 「어느 쪽인가」는 단조라 승률이 바로 쓰인다. 같은 피처를 두 곳에
그대로 쓰면 안 된다는 것이 이 표의 요지다.

표본이 조정된 챔피언으로 한정돼 작다. 그리고 라벨의 대부분이 Data Dragon
자동 판정이라 **스탯·쿨다운 조정 쪽으로 치우쳐 있다.** 손 라벨이 쌓이면
그 치우침이 줄어든다.
"""

from __future__ import annotations

import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from sklearn.linear_model import LogisticRegression  # noqa: E402
from sklearn.neighbors import KNeighborsClassifier  # noqa: E402
from sklearn.pipeline import make_pipeline  # noqa: E402
from sklearn.preprocessing import StandardScaler  # noqa: E402

from lol_balance.baseline import (  # noqa: E402
    direction_rows,
    encode,
    fit_encoder,
    roc_auc,
)
from lol_balance.config import load_settings  # noqa: E402
from lol_balance.panel import patch_index  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402

PANEL = ROOT / "data" / "panel.sqlite"


def arg(flag: str, default: str) -> str:
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv else default


def accuracy(y: np.ndarray, score: np.ndarray) -> float:
    """0.5 를 문턱으로 한 정확도. 두 집단 크기가 비슷할 때만 뜻이 있다."""
    return float(((score >= 0.5).astype(int) == y).mean())


def main() -> int:
    split = arg("--split", "15_13")
    seed = load_settings().seed
    rows = direction_rows(read_panel(PANEL))
    if not rows:
        print("방향 라벨이 없다. ./scripts/build-panel 을 먼저 돌린다.")
        return 1

    cut = patch_index(split)
    train = tuple(r for r in rows if r.patch_index < cut)
    test = tuple(r for r in rows if r.patch_index >= cut)
    hand = sum(1 for r in rows if r.direction_source == "label")

    def spread(part: tuple) -> str:  # type: ignore[type-arg]
        nerf = sum(1 for r in part if r.direction_next == "nerf")
        return f"{len(part):3}건 (너프 {nerf} · 버프 {len(part) - nerf})"

    print(f"시드 {seed} · 분할 {split} 앞뒤 · 손 라벨 {hand}건 / {len(rows)}건")
    print(f"  학습 {spread(train)}")
    print(f"  평가 {spread(test)}")
    base = sum(1 for r in test if r.direction_next == "nerf") / len(test)
    print(f"  평가 구간 너프 비율(기준선) {base:.1%}\n")

    print(f"{'arm':5}{'방법':32}{'AUC':>8}{'정확도':>9}")
    print("-" * 55)

    flat = fit_encoder(train, with_trend=False)
    te = encode(test, flat, target="direction")
    rng = np.random.default_rng(seed)
    results = [
        (
            "B0",
            "무작위",
            *(lambda s: (roc_auc(te.y, s), accuracy(te.y, s)))(rng.random(len(te))),
        )
    ]

    for name, label, column in (
        ("B0b", "승률 높은 순", "win_rate"),
        ("B0c", "밴율 높은 순", "ban_rate"),
        ("B0d", "픽률 높은 순", "pick_rate"),
    ):
        score = te.x[:, te.columns.index(column)]
        # 단일 피처는 확률이 아니므로 정확도는 재지 않는다.
        results.append((name, label, roc_auc(te.y, score), float("nan")))

    for name, label, trend in (
        ("B1", "로지스틱 회귀 — 수준", False),
        ("B2", "로지스틱 회귀 — 수준 + 추세", True),
    ):
        enc = fit_encoder(train, with_trend=trend)
        tr = encode(train, enc, target="direction")
        ts = encode(test, enc, target="direction")
        model = make_pipeline(
            StandardScaler(),
            LogisticRegression(
                max_iter=2000, class_weight="balanced", random_state=seed
            ),
        )
        model.fit(tr.x, tr.y)
        score = model.predict_proba(ts.x)[:, 1]
        results.append((name, label, roc_auc(ts.y, score), accuracy(ts.y, score)))

    tr = encode(train, flat, target="direction")
    knn = make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=25))
    knn.fit(tr.x, tr.y)
    score = knn.predict_proba(te.x)[:, 1]
    results.append(
        ("B3", "유사 사례 25개 (k-NN)", roc_auc(te.y, score), accuracy(te.y, score))
    )

    for name, label, auc, acc in results:
        shown = "—" if np.isnan(acc) else f"{acc:.1%}"
        print(f"{name:5}{label:32}{auc:>8.3f}{shown:>9}")

    print("\nAUC 0.5 면 무작위. 대상 예측에서는 승률이 0.451 이었다 — 같은 피처가")
    print(
        "과제에 따라 반대로 움직인다는 것이 `docs/spec/prediction-signals.md` 에 있다."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
