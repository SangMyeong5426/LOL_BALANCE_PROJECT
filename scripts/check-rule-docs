#!/usr/bin/env bash
# AGENTS.md 와 CLAUDE.md 는 같은 문서다. 한쪽만 고친 상태로 두지 않는다.
#
# 사람의 기억에 맡기면 반드시 갈라지고, 갈라진 뒤에는 어느 쪽이 최신인지
# 확정할 수 없다. 그때는 두 문서 모두 신뢰할 수 없게 된다.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! diff -q AGENTS.md CLAUDE.md >/dev/null 2>&1; then
  echo "AGENTS.md 와 CLAUDE.md 가 다르다. 한쪽만 고쳤는지 확인한다." >&2
  echo >&2
  diff AGENTS.md CLAUDE.md >&2 || true
  echo >&2
  echo "어느 쪽이 맞는지 임의로 정하지 않는다. 양쪽 원문을 놓고 판단한다." >&2
  exit 1
fi
echo "AGENTS.md == CLAUDE.md"
