#!/usr/bin/env python3
"""현재 패치의 직접 집계를 하루치 더 쌓는다 — 예약 작업이 매시간 확인하고 부른다.

    ./scripts/fetch-riot-daily            # 플랫폼마다 300판 더 (지금 바로)
    ./scripts/fetch-riot-daily --add 500
    ./scripts/fetch-riot-daily --check    # 예약 실행이라면 지금 돌지 말한다 (요청 없음)

**키가 필요하다**(ADR 0010). 현재 패치는 Data Dragon 의 가장 새 버전으로 정한다
(`16.18.1` → `16_18`). 창은 지난 26시간 — 하루에 한 번 돌리므로 두 시간을 겹쳐
놓치는 틈을 없앤다. 겹친 경기는 경기 ID 로 걸러진다. 며칠 못 돌았으면 마지막으로
받은 경기부터 메운다(`window_start`).

패치가 바뀐 날에는 창 안에 앞 패치 경기가 섞인다. `gameVersion` 으로 갈라 **앞 패치
경기는 그 패치 파일에 잇는다**(`fetch-riot --tail` — 받던 패치만, 하루치까지). 버리면
패치마다 마지막 날이 빈다. 새 패치의 첫 실행은 앞 패치에서 마지막으로 받은 경기부터 본다.

예약은 `./scripts/install-riot-daily` 가 건다. 예약 작업은 매시간 `--scheduled` 로
부르고, 그때는 **마지막으로 경기를 받은 지 20시간이 지났고 맥이 제대로 깨어 있을
때만** 돈다. 덮개를 닫은 맥은 밤새 몇 초씩만 깨므로(다크웨이크) 새벽에 시작하면
몇 시간을 기어간다 — 2026-09-29 새벽이 그랬다. 손으로 부를 때는 확인 없이 바로 돈다.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
import time
from collections.abc import Callable
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from lol_balance.fetch import get_with_retry  # noqa: E402

ROOT = Path(__file__).resolve().parents[1]
VERSIONS = "https://ddragon.leagueoflegends.com/api/versions.json"
WINDOW_HOURS = 26
# 우리 패치 표기. `data/riot/` 에는 `v1`(옛 형식 보관함)도 있다
PATCH = re.compile(r"^(\d+)_(\d+)$")
# **한 번에 이만큼을 넘기면 포기한다.** 맥이 자는 동안 멈췄다 깨기를 되풀이하면
# 한 실행이 며칠씩 걸리고, `launchd` 는 같은 작업이 돌고 있으면 새로 안 띄운다.
# 그래서 하루가 늦는 것이 아니라 **그 뒤로 전부 건너뛴다** — 2026-09-22 실행이
# 엿새를 붙들어 닷새치를 통째로 잃었다. 그때는 창이 26시간뿐이라 놓친 날을 못
# 채웠다(지금은 `window_start` 가 마지막 경기부터 메운다).
#
# **다만 맥이 자는 시간은 세지 않는다.** 2026-09-29 실행은 벽시계로 3시간 45분을
# 넘겼는데도 걸리지 않았다 — 거의 내내 자고 있었다. 그래서 예약 실행은 아예 맥이
# 깨어 있을 때만 시작한다(`awake`).
DEADLINE_MINUTES = 150
# **예약 실행은 하루 한 번이다.** 매시간 확인하되, 마지막으로 경기를 받은 지 이만큼이
# 안 됐으면 그냥 끝낸다. 24가 아니라 20인 것은 맥을 여는 시각이 날마다 달라서다 —
# 어제 09:25 에 끝났는데 오늘 08:00 에 열었다고 하루를 거르지 않게 한다.
MIN_GAP_HOURS = 20


def code_line() -> str:
    """**어느 코드가 이 경기를 받았나.**

    예약 작업은 `cd <저장소>` 만 하고 브랜치를 고정하지 않는다. 실험 브랜치를
    체크아웃해 둔 채 자면 다음 날 수집이 그 코드로 돈다 — 거르는 규칙이나 창이
    바뀐 코드일 수 있다. 막지는 않는다(하루를 통째로 잃는 쪽이 더 나쁘다).
    **대신 무엇으로 받았는지 로그에 남겨 나중에 되짚을 수 있게 한다.**
    """

    def git(*args: str) -> str:
        done = subprocess.run(
            ["git", *args], cwd=ROOT, capture_output=True, text=True, check=False
        )
        return done.stdout.strip()

    branch = git("rev-parse", "--abbrev-ref", "HEAD") or "?"
    commit = git("rev-parse", "--short", "HEAD") or "?"
    dirty = bool(git("status", "--porcelain", "--untracked-files=no"))
    mark = "" if branch == "main" else "  ⚠ main 이 아니다"
    return f"코드 {branch} {commit}{' · 작업 트리 더러움' if dirty else ''}{mark}"


def last_game(patch: str) -> datetime | None:
    """그 패치에서 **마지막으로 받은 경기의 시작 시각.** 없으면 `None`."""
    folder = ROOT / "data" / "riot" / patch
    if not folder.is_dir():
        return None
    newest = 0
    for f in folder.glob("*.jsonl"):
        for line in f.read_text().splitlines():
            if not line.strip():
                continue
            try:
                # 저장 칸 이름은 `start` 다(riot.dumps). 여기서 어긋나면 조용히 못 메운다.
                newest = max(newest, int(json.loads(line)["start"]))
            except (KeyError, ValueError, TypeError):
                continue
    return datetime.fromtimestamp(newest / 1000, UTC) if newest else None


def previous_patch(patch: str) -> str | None:
    """`patch` 앞에서 **받던** 패치 — 경기가 있는 폴더 가운데 가장 새 것. 없으면 `None`.

    이름을 숫자로 견준다(`16_9` < `16_19` < `17_1`). 빈 파일뿐인 폴더는 받은 것이
    아니다 — 0판으로 끝난 실행이 그런 폴더를 남긴다.
    """
    current = PATCH.match(patch)
    if current is None:
        return None
    older: list[tuple[tuple[int, int], str]] = []
    for folder in (ROOT / "data" / "riot").glob("*"):
        named = PATCH.match(folder.name)
        if named is None or not folder.is_dir():
            continue
        number = (int(named[1]), int(named[2]))
        if number < (int(current[1]), int(current[2])) and any(
            f.stat().st_size for f in folder.glob("*.jsonl")
        ):
            older.append((number, folder.name))
    return max(older)[1] if older else None


def window_start(patch: str) -> datetime:
    """창의 시작. **놓친 날이 있으면 마지막으로 받은 경기부터 메운다.**

    보통은 지난 26시간이다(두 시간을 겹쳐 틈을 없앤다). 맥이 자거나 꺼져 있으면
    그날 실행이 통째로 빠지고, 26시간 창만 보면 그 사이가 영영 빈다 — 그래서 며칠
    못 돌았으면 마지막 경기부터 잡는다.

    **거슬러 가는 데 한계를 두지 않는다.** 2026-10-06 까지는 96시간에서 끊었다.
    「이용자 기록은 최근 20판까지만 보여 그 너머는 받아도 버려진다」고 적었는데
    틀렸다 — 경기 목록은 창(`startTime` · `endTime`)으로 묻고, `16_13` 은 75 ~ 88일
    지난 창을 평소 속도로 받았다. 그날 실행은 한계 164초 전에 시작해 겨우 이어졌다.

    보는 것은 **이 패치의** 마지막 경기다. **이 패치를 아직 한 판도 안 받았으면 앞
    패치에서 마지막으로 받은 경기부터 본다** — 패치 교체일을 끼고 덮개를 닫아 두면
    26시간 창으로는 앞 패치의 끝도 새 패치의 처음도 못 받는다. 2026-10-06 에는 「앞
    패치가 창을 끌고 가면 몇 주를 거슬러 가 전부 버린다」며 막아 뒀는데, 창 안의 앞 패치
    경기를 그 패치에 잇게 되어(`fetch-riot --tail`) 하루 만에 풀었다.

    **양은 그대로다** — 창이 넓어져도 `--add` 만큼만 받으므로 빈 날은 얇게 찬다.
    """
    usual = datetime.fromtimestamp(time.time() - WINDOW_HOURS * 3600, UTC)
    seen = last_game(patch)
    if seen is None:
        before = previous_patch(patch)
        seen = last_game(before) if before else None
    if seen is None or seen >= usual:
        return usual
    return seen


def too_soon(now: datetime) -> float | None:
    """마지막으로 경기를 받은 지 `MIN_GAP_HOURS` 가 안 됐으면 그 시간(시간 단위).

    **받은 파일이 마지막으로 바뀐 때**를 본다. 따로 기록 파일을 두지 않는다 — 받은
    것이 곧 기록이다. 그래서 손으로 더 받은 날도 「받았다」로 치고, 한 판도 못 받은
    실행은 「안 받았다」로 쳐서 다음 확인 때 다시 돈다.

    **빈 파일은 세지 않는다.** 새 패치의 첫 실행이 0판으로 끝나면 빈 파일이 남는다.
    2026-10-07 에 그 파일이 방금 생겼다는 이유로 스무 시간 동안 다시 돌지 않았다.
    """
    files = [f for f in (ROOT / "data" / "riot").glob("*/*.jsonl") if f.stat().st_size]
    if not files:
        return None
    newest = datetime.fromtimestamp(max(f.stat().st_mtime for f in files), UTC)
    hours = (now - newest).total_seconds() / 3600
    return hours if hours < MIN_GAP_HOURS else None


def awake(
    run: Callable[..., subprocess.CompletedProcess[str]] = subprocess.run,
) -> bool:
    """**맥이 제대로 깨어 있나.** 다크웨이크에는 화면 기능이 없다.

    `pmset -g systemstate` 는 깨어 있을 때 「CPU Graphics Audio Network」라고
    답한다. `Graphics` 가 빠져 있으면 덮개를 닫은 맥이 몇 초만 깬 것이다 —
    2026-09-29 새벽에는 15분마다 깨어 한 번에 2~45초였다. 그때 시작하면 몇 초
    돌고 자기를 되풀이한다. 05:19 에 시작한 실행이 이용자 목록 조회를 07:21 에야
    마쳤고, 경기는 맥을 연 08:59 뒤에야 제 속도로 받았다.

    **판단할 수 없으면 깨어 있다고 본다** — 맥이 아니거나 답의 형식이 다르면
    예전처럼 돈다. 여기서 잘못 막아 하루를 통째로 잃는 쪽이 더 나쁘다.
    """
    try:
        done = run(
            ["pmset", "-g", "systemstate"],
            capture_output=True,
            text=True,
            check=False,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return True
    line = next((x for x in done.stdout.splitlines() if "Capabilities" in x), None)
    return line is None or "Graphics" in line


def current_patch() -> str:
    """Data Dragon 의 가장 새 버전 → 우리 패치 표기."""
    versions = json.loads(get_with_retry(VERSIONS, validate=json.loads).decode())
    major, minor, *_ = versions[0].split(".")
    return f"{major}_{minor}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--add", type=int, default=300, help="플랫폼마다 더 받을 판수")
    parser.add_argument(
        "--deadline",
        type=int,
        default=DEADLINE_MINUTES,
        help=f"이 분을 넘기면 포기한다 (기본 {DEADLINE_MINUTES})",
    )
    parser.add_argument(
        "--scheduled",
        action="store_true",
        help="예약 작업이 부른다 — 하루 한 번, 맥이 깨어 있을 때만 돈다",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="예약 실행이라면 지금 돌지만 말하고 끝낸다 (요청을 보내지 않는다)",
    )
    args = parser.parse_args()

    # **네트워크를 쓰기 전에 본다.** 건너뛸 때는 요청을 한 건도 보내지 않는다.
    if args.scheduled or args.check:
        now = datetime.now(UTC)
        hours = too_soon(now)
        if hours is not None:
            # 하루에 스무 번 넘게 되풀이되므로 예약 실행에서는 적지 않는다
            if args.check:
                print(
                    f"안 돈다 — 마지막으로 받은 지 {hours:.1f}시간이다"
                    f" ({MIN_GAP_HOURS}시간이 지나야 돈다)"
                )
            return 0
        if not awake():
            # 적어 둔다 — 다크웨이크를 제대로 가려내는지 이 줄로 확인한다
            print(
                f"··· {now:%Y-%m-%d %H:%MZ} 건너뜀 — 맥이 화면 없이 잠깐 깬 상태다"
                "(다크웨이크). 맥이 열리면 돈다",
                flush=True,
            )
            return 0
        if args.check:
            print(
                f"돈다 — 맥이 깨어 있고 마지막으로 받은 지 {MIN_GAP_HOURS}시간이 지났다"
            )
            return 0

    patch = current_patch()
    since = window_start(patch)
    stamp = datetime.now(UTC).strftime("%Y-%m-%d %H:%MZ")
    gap = (datetime.now(UTC) - since).total_seconds() / 3600
    how = (
        f"지난 {WINDOW_HOURS}시간"
        if gap <= WINDOW_HOURS + 1
        else f"**{gap:.0f}시간을 메운다** — 마지막 경기 뒤로 못 돌았다"
    )
    print(f"=== {stamp} · 현재 패치 {patch} · {how} · {code_line()}", flush=True)
    command = [
        sys.executable,
        str(ROOT / "scripts" / "fetch-riot"),
        patch,
        "--since",
        since.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "--add",
        str(args.add),
    ]
    # 창 안에서 앞 패치 경기를 만나면 버리지 않고 그 패치에 잇는다. 만나지 않는 날에는
    # 아무 일도 없다 — 패치가 바뀌는 며칠만 쓰인다
    before = previous_patch(patch)
    if before:
        command += ["--tail", before]
    try:
        return subprocess.call(command, cwd=ROOT, timeout=args.deadline * 60)
    except subprocess.TimeoutExpired:
        # **받은 것은 남는다** — `fetch-riot` 은 한 판씩 파일에 덧붙인다.
        print(
            f"멈춤 — {args.deadline}분을 넘겨 포기한다. 받은 것까지는 남는다."
            " 내일 실행이 막히지 않게 여기서 끊는다.",
            flush=True,
        )
        return 1


if __name__ == "__main__":
    sys.exit(main())
