#!/usr/bin/env python3
"""Data Dragon 에서 아이템 수치 스냅샷을 받는다.

    ./scripts/fetch-items [--all]

챔피언과 같은 CDN, 같은 버전 체계다. **새 출처가 아니므로 지역·티어가 섞일
여지가 없다** — 아이템은 애초에 지역별로 다르지 않다.

**왜 필요한가.** 조정의 상당수가 아이템으로 이뤄지는데 정답지에는 챔피언 절만
들어 있다. Lucian–Nami 가 `14_9` 24.0% 에서 `14_10` 6.0% 로 무너졌을 때 두
챔피언 모두 「조정 안 됨」이었고, 무너뜨린 것은 `Essence Reaver` 의 골드가
2900 에서 3200 으로 오른 것이었다. 이 스냅샷이 그것을 본다.

`item.json` 하나에 전 아이템이 들어 있어 버전당 요청이 한 번이다.
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from lol_balance.fetch import Retryable, get_with_retry, save  # noqa: E402

BASE = "https://ddragon.leagueoflegends.com"
OUT = Path(__file__).resolve().parents[1] / "data" / "items"

# 챔피언 스냅샷과 같은 범위를 쓴다. docs/spec/data-sources.md 7장.
FIRST = (13, 14)
LAST = (16, 15)


def in_scope(version: str) -> bool:
    m = re.match(r"^(\d+)\.(\d+)\.", version)
    if not m:
        return False
    return FIRST <= (int(m.group(1)), int(m.group(2))) <= LAST


def main() -> int:
    take_all = "--all" in sys.argv
    versions = json.loads(
        get_with_retry(f"{BASE}/api/versions.json", validate=json.loads).decode()
    )
    targets = sorted(
        set(versions if take_all else [v for v in versions if in_scope(v)])
    )
    print(f"대상 {len(targets)}개 버전 (전체 {len(versions)}개 중)", flush=True)

    done = skipped = failed = 0
    for i, v in enumerate(targets, 1):
        path = OUT / f"{v}.json"
        if path.exists():
            skipped += 1
            continue
        try:
            body = get_with_retry(
                f"{BASE}/cdn/{v}/data/en_US/item.json",
                attempts=3,
                base_delay=5.0,
                validate=json.loads,
            )
            save(path, body)
            done += 1
            print(f"[{i}/{len(targets)}] {v}  {len(body):,}B", flush=True)
        except (Retryable, ValueError) as exc:
            failed += 1
            print(f"[{i}/{len(targets)}] {v}  실패: {exc}", flush=True)

    print(f"\n완료: 새로 받음 {done} · 건너뜀 {skipped} · 실패 {failed}", flush=True)
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
