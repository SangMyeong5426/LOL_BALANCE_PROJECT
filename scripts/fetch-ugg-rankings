#!/usr/bin/env python3
"""u.gg `rankings` 응답을 원본 그대로 받아 둔다.

**아직 해독하지 않은 형식이다.** 그래서 검증하지 않고 저장만 한다 — 받는 것이
느리고 해독은 빠르므로, 원본을 먼저 확보해 두면 해독할 때 다시 받지 않아도 된다.

두 묶음을 받는다.

1. `champion_ranking` 에 없는 결측 패치 — 이것이 목적이다
2. 겹치는 패치 몇 개 — **해독이 맞았는지 검증할 대조군.** 같은 패치에서 두
   엔드포인트가 같은 승률을 주면 해독이 맞은 것이다

    ./scripts/fetch-ugg-rankings [--delay 2.0]
"""

from __future__ import annotations

import json
import re
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from patchlens.fetch import Retryable, get_with_retry, save  # noqa: E402

OUT = Path(__file__).resolve().parents[1] / "data" / "ugg" / "rankings"
CDX = (
    "https://web.archive.org/cdx/search/cdx?url=stats2.u.gg*&output=json"
    "&fl=timestamp,original&filter=statuscode:200"
    "&filter=original:.*rankings.*ranked_solo_5x5.*"
    "&collapse=urlkey&limit=5000&from=2023"
)

# champion_ranking 에 없어서 이것으로 메워야 하는 패치
GAP = """14_16 14_17 14_18 14_19 14_20 14_22 14_24
         15_3 15_7 15_9 15_10 15_16 15_17 15_22
         16_3 16_7 16_14""".split()

# 해독 검증용 대조군 — champion_ranking 에도 있는 패치
OVERLAP = "13_20 14_5 15_14 16_9 16_13".split()

URL_RE = re.compile(r"/rankings/(\d{1,2}_\d{1,2})/ranked_solo_5x5/(\d+)/")


def delay_arg() -> float:
    if "--delay" in sys.argv:
        return float(sys.argv[sys.argv.index("--delay") + 1])
    return 2.0


def main() -> int:
    delay = delay_arg()
    wanted = set(GAP) | set(OVERLAP)
    rows = json.loads(get_with_retry(CDX, timeout=180).decode())[1:]

    targets: dict[tuple[str, str], tuple[str, str]] = {}
    for ts, url in rows:
        m = URL_RE.search(url)
        if m and m.group(1) in wanted:
            targets.setdefault((m.group(1), m.group(2)), (ts, url))

    by_patch: dict[str, int] = {}
    for patch, _champ in targets:
        by_patch[patch] = by_patch.get(patch, 0) + 1
    print(f"대상 {len(targets)}개 파일 · 패치 {len(by_patch)}종", flush=True)
    for p in sorted(by_patch, key=lambda x: tuple(int(i) for i in x.split("_"))):
        tag = "결측메움" if p in GAP else "대조군"
        print(f"  {p:7} 챔피언 {by_patch[p]:3}개  ({tag})", flush=True)
    print(f"예상 소요: 약 {len(targets) * delay / 60:.0f}분\n", flush=True)

    done = skipped = failed = 0
    items = sorted(targets)
    for i, (patch, champ) in enumerate(items, 1):
        path = OUT / patch / f"{champ}.json"
        if path.exists():
            skipped += 1
            continue
        ts, url = targets[(patch, champ)]
        try:
            body = get_with_retry(f"https://web.archive.org/web/{ts}id_/{url}")
            json.loads(body)  # 온전한 JSON 인지만 본다. 해독은 나중에
            save(path, body)
            done += 1
        except (Retryable, ValueError) as exc:
            failed += 1
            print(f"  {patch}/{champ} 실패: {exc}", flush=True)
        if i % 50 == 0:
            print(
                f"[{i}/{len(items)}] 받음 {done} · 건너뜀 {skipped} · 실패 {failed}",
                flush=True,
            )
        time.sleep(delay)

    print(f"\n완료: 새로 받음 {done} · 건너뜀 {skipped} · 실패 {failed}", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
