#!/usr/bin/env python3
"""한 챔피언을 놓고 **검색기 셋이 무엇을 찾아오는지** 보여 준다.

    ./scripts/ask Senna 16_13
    ./scripts/ask Senna 16_13 --answer     실제 결과까지 보인다

`run-report` 는 성적을 재고 `predict` 는 후보를 줄 세운다. **이것은 RAG 가
제대로 도는지 사람이 직접 보는 자리다** — 무엇을 찾아왔고 그것이 말이 되는지.

## 근거 → 예측 → 답

마지막에 **모델이 어떻게 보는지**를 세 갈래로 낸다. 「조정되나」 하나로만 물으면
프로 픽·밴율의 신호가 방향에 따라 반대라 상쇄된다.

`--answer` 없이는 실제 결과를 안 찍는다. **근거를 읽고 스스로 판단한 뒤, 모델과
맞춰 보고, 그다음 답을 여는 것**이 이 도구를 시험하는 순서다.

## 경계는 도구가 지킨다

`as_of` 를 검색기 생성자에 넘기므로 **물어본 패치 이후 정보는 검색 풀에 아예
안 들어간다.** 여기서 빠뜨려도 미래가 새지 않는다.
"""

from __future__ import annotations

import sys
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from lol_balance.arms import rank_candidates  # noqa: E402
from lol_balance.assemble import forecast_rows  # noqa: E402
from lol_balance.baseline import direction_rows  # noqa: E402
from lol_balance.config import load_settings  # noqa: E402
from lol_balance.explain import outcome, patch_notes, reasons  # noqa: E402
from lol_balance.items import churn_by_patch  # noqa: E402
from lol_balance.oracle import read_pro  # noqa: E402
from lol_balance.panel import (  # noqa: E402
    PATCH_SEQUENCE,
    as_patch,
    name_after,
    next_patch,
    patch_index,
)
from lol_balance.patchnotes import champion_changes  # noqa: E402
from lol_balance.retrieval import CaseSearch, NoteSearch, StatLookup  # noqa: E402
from lol_balance.rules import read_rules  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402

PANEL = ROOT / "data" / "panel.sqlite"
NOTES = ROOT / "data" / "patchnotes"
RULES = ROOT / "rules" / "proposed.jsonl"
ITEMS = ROOT / "data" / "items"
RANKING = ROOT / "data" / "ugg" / "champion_ranking"
DDRAGON = ROOT / "data" / "ddragon"
ORACLE = ROOT / "data" / "oracle"


def lifetime_pro(rows: tuple, champion: str) -> float | None:
    """통산 프로 픽·밴율. 한 패치만 튀는 것과 늘 나오는 것은 다르다."""
    seen = [r.pro_presence for r in rows if r.champion == champion and r.pro_presence]
    return sum(seen) / len(seen) if len(seen) >= 20 else None


def main() -> int:
    if "--patches" in sys.argv:
        if not PANEL.exists():
            print("data/panel.sqlite 가 없다. ./scripts/build-panel 을 먼저 돌린다.")
            return 1
        covered = sorted({r.patch for r in read_panel(PANEL)}, key=patch_index)
        print(f"지표가 있는 패치 {len(covered)}개")
        for i in range(0, len(covered), 8):
            print("  " + " · ".join(covered[i : i + 8]))
        # **「지표가 없다」와 「패널에서만 빠졌다」는 다르다.** 마지막 패치는
        # 라벨을 못 만들어 빠지는 것이라 지표는 있고 예측도 된다.
        have = {f.stem for f in RANKING.glob("*.json")} if RANKING.is_dir() else set()
        forecast = [p for p in PATCH_SEQUENCE if p not in covered and p in have]
        missing = [p for p in PATCH_SEQUENCE if p not in covered and p not in have]
        if forecast:
            print(f"\n답이 없는 패치 {len(forecast)}개 — 예측만 된다")
            print("  " + " · ".join(forecast))
        print(f"\n지표가 없는 패치 {len(missing)}개 — u.gg 아카이브 결측")
        for i in range(0, len(missing), 8):
            print("  " + " · ".join(missing[i : i + 8]))
        return 0

    if len(sys.argv) < 3:
        print(__doc__)
        return 1
    champion, at = sys.argv[1], as_patch(sys.argv[2])
    reveal = "--answer" in sys.argv

    if not PANEL.exists():
        print("data/panel.sqlite 가 없다. ./scripts/build-panel 을 먼저 돌린다.")
        return 1
    rows = read_panel(PANEL)
    # **무엇이 없는지 갈라서 말한다.** 한때 셋을 「패널에 없다」 하나로 묶었더니
    # 패치가 결측인데도 챔피언 이름을 의심하게 됐다. u.gg 아카이브에 22패치가
    # 없어서 흔히 걸린다.
    if at not in PATCH_SEQUENCE:
        print(f"{at} 은 아는 패치가 아니다. {PATCH_SEQUENCE[0]} ~ {PATCH_SEQUENCE[-1]}")
        if at.count("_") > 1:
            print(
                "  세 자리는 Data Dragon 표기다. 패치는 두 자리로 쓴다 — 16_15 · 16.15 둘 다 된다"
            )
        return 2

    covered = sorted({r.patch for r in rows}, key=patch_index)
    if at not in covered and (RANKING / f"{at}.json").exists():
        # **패널에 없어도 지표가 있으면 본다.** 마지막 패치는 라벨을 못 만들어
        # 빠지는 것이지 자료가 없는 것이 아니다(`predict` 와 같은 처리).
        rows = rows + forecast_rows(
            at,
            rows,
            ranking=RANKING,
            ddragon=DDRAGON,
            pro=read_pro(ORACLE) if ORACLE.is_dir() else None,
        )
        covered = sorted({r.patch for r in rows}, key=patch_index)
    if at not in covered:
        near = [p for p in covered if abs(patch_index(p) - patch_index(at)) <= 3]
        print(f"{at} 은 지표가 없다 — u.gg 아카이브에 그 패치 스냅샷이 없다.")
        print(f"  가까운 패치: {' · '.join(near) if near else covered[-5:]}")
        print("  전부 보려면: ./scripts/ask --patches")
        return 2

    target = next((r for r in rows if r.champion == champion and r.patch == at), None)
    if target is None:
        near = sorted(
            {r.champion for r in rows if champion.lower() in r.champion.lower()}
        )
        print(
            f"{at} 에 {champion} 이 없다."
            + (f" 비슷한 이름: {near[:5]}" if near else "")
        )
        if not near:
            print("  이름은 영문 정식 표기다 — Nunu & Willump · Bel'Veth · K'Sante")
        return 2

    nxt = next_patch(at) or name_after(at)
    print(f"■ {champion} · {at} → {nxt}")
    print(f"  {at} 까지만 보고 판단한다\n")

    churn = churn_by_patch(ITEMS).get(nxt) if ITEMS.is_dir() else None
    for note in patch_notes(churn):
        print(f"  ⚠ {note.text}\n")

    stat = StatLookup(rows, at)
    # **읽는 순서를 자기 지표 → 자기 이력 → 남의 사례로 둔다.** 검색기 번호
    # (R1·R2·R3) 순으로 찍으면 남의 사례가 자기 이력보다 먼저 나와 읽기 어렵다.
    # 표는 전부 패치 순이다 — 시간이 뒤섞이면 흐름이 안 보인다.

    print("── 지표       (최근 여섯 패치)")
    print(f"  {'패치':8}{'승률':>7}{'픽률':>8}{'밴율':>8}{'판수':>12}")
    history = [r for r in stat.champion(champion)[-5:]] + [target]
    for row in history:
        here = "  ← 기준" if row.patch == at else ""
        print(
            f"  {row.patch:8}{row.win_rate:>7.1%}{row.pick_rate:>8.1%}"
            f"{(row.ban_rate or 0):>8.1%}{row.matches:>12,}{here}"
        )

    if NOTES.is_dir():
        blocks: dict[str, list] = defaultdict(list)
        for path in sorted(NOTES.glob("*.html")):
            patch = path.stem.rsplit(".", 1)[0].replace(".", "_")
            blocks[patch].extend(champion_changes(path.read_bytes()))
        # **이름만으로 질의하면 스킨 버그 수정이 최상위로 올라온다.** 그래서
        # 실제로 조정된 패치로 좁혀 묻는다 — 토크나이저가 패치 번호를 살리므로
        # 「이름 + 패치」가 통한다(Recall@10 56.3% → 99.2%).
        search = NoteSearch(blocks, at)
        adjusted = [
            n
            for r in stat.champion(champion)
            if r.adjusted_next and (n := next_patch(r.patch))
        ]
        print("\n── 조정 이력")
        if not adjusted:
            print("  없다")
        for patch in adjusted[-4:]:
            # **스킨 절을 걸러 낸다.** 「Bewitching Senna」처럼 절 이름이 챔피언
            # 이름을 또 담고 있어 BM25 점수가 높게 나오는데, 스킨은 밸런스
            # 조정이 아니다. 능력치·스킬 절은 이름을 안 담는다.
            hits = [
                block
                for _, block, _ in search.search(f"{champion} {patch}", k=6)
                if champion.split()[0].lower() not in block.section.lower()
            ]
            for block in hits[:1]:
                print(f"  {patch:8}{block.section[:18]:20}{block.lines[0][:66]}")

    pool = direction_rows(rows)
    cases = CaseSearch(pool, at).similar(target, k=10)
    print("\n── 닮은 사례  (지표가 비슷한 과거 기록)")
    print(f"  {'패치':8}{'챔피언':16}{'승률':>7}{'밴율':>8}{'거리':>7}   결과")
    # **가까운 순이 아니라 패치 순으로 찍는다.** 거리는 칸으로 남기므로 어느
    # 것이 가까운지는 그대로 읽힌다.
    for case in sorted(cases, key=lambda c: c.row.patch_index):
        print(
            f"  {case.row.patch:8}{case.row.champion:16}{case.row.win_rate:>7.1%}"
            f"{(case.row.ban_rate or 0):>8.1%}{case.distance:>7.2f}   "
            f"{case.row.direction_next}"
        )

    # **위 표와 겹치는 줄은 뺀다.** `reasons` 는 `predict` 의 한 줄짜리 목록을
    # 위한 것이라 사례 요약까지 담는데, 여기서는 그 표가 바로 위에 있다.
    notes = reasons(
        target,
        [r for r in rows if r.patch == at],
        CaseSearch(pool, at).similar(target, k=25),
        read_rules(RULES) if RULES.exists() else (),
        lifetime_pro(rows, champion),
    )
    facts = [n for n in notes if not n.warn and not n.text.startswith("닮은 사례")]
    alerts = [n for n in notes if n.warn]

    print("\n── 근거")
    for note in facts:
        print(f"  {note.text}")

    if alerts:
        print("\n── 주의")
        for note in alerts:
            print(f"  ⚠ {note.text}")

    # **근거만 보이고 예측을 안 하면 반쪽이다.** 세 갈래를 따로 낸다 —
    # 「조정되나」 하나로만 물으면 프로 픽·밴율의 신호가 방향에 따라 반대라
    # 상쇄된다(너프 쪽 AUC 0.658 · 버프 쪽 0.473).
    train = tuple(r for r in rows if r.patch_index < patch_index(at))
    here = tuple(r for r in rows if r.patch == at)
    spot = here.index(target)
    seed = load_settings().seed

    print(f"\n── 예측       ({len(here)}종 중 순위 · 학습 {len(train):,}행)")
    adjusted = 0.0
    for label, want in (("조정", None), ("너프", "nerf"), ("버프", "buff")):
        score = rank_candidates(train, here, want=want, seed=seed)
        place = int((score > score[spot]).sum()) + 1
        bar = "█" * round(score[spot] * 20)
        print(f"  {label:6}{score[spot]:>6.2f}{place:>6}위   {bar}")
        if want is None:
            adjusted = float(score[spot])

    # **따로 재지 않는다.** 점수가 `predict_proba` 라 조정의 여집합이 그대로
    # 「조정 안 됨」 확률이다. 이름이 안 붙어 있어 「그 예측은 없나」로 읽혔다.
    # **순위는 안 매긴다** — 패널의 81.8% 가 여기라 줄 세워도 정보가 없다.
    #
    # **「유지」라고 쓰지 않는다.** 한 번 그렇게 넣었다가 되돌렸다 — 저장소가
    # 이미 「조정 안 됨」으로 부르는 것을 두 이름으로 만들면 읽는 사람이 다른
    # 것으로 읽는다(`CLAUDE.md` 「용어를 새로 만들지 않는다」).
    print(f"  → 조정 안 됨 {1 - adjusted:.2f}. 조정의 여집합이라 따로 재지 않는다")

    if reveal:
        print(f"\n── 답         {nxt} → {outcome(target)}")
    else:
        print("\n답을 보려면 --answer")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
