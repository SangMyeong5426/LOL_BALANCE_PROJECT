#!/usr/bin/env python3
"""패치 × 챔피언 표를 만든다.

    ./scripts/build-panel

**LLM 도 API 키도 필요 없다.** 라벨(누가 조정됐나)은 위키가 `data-champion`
속성에 넣어 둔 이름을 파서가 읽어서 준다.

같은 원자료에서 항상 같은 결과가 나와야 한다 — 그래야 커밋하지 않아도 된다.
정렬 순서까지 고정한다.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from lol_balance.cdragon import field_changes, read_champion  # noqa: E402
from lol_balance.ddragon import diff_versions, standard_champions  # noqa: E402
from lol_balance.direction import (  # noqa: E402
    Direction,
    champion_direction,
    drop_mass_changes,
    value_direction,
)
from lol_balance.groundtruth import read_labels  # noqa: E402
from lol_balance.panel import (  # noqa: E402
    PATCH_SEQUENCE,
    PanelRow,
    champion_names,
    patch_rows,
)
from lol_balance.patchnotes import champion_changes  # noqa: E402
from lol_balance.store import write_panel  # noqa: E402
from lol_balance.ugg import parse_champion_ranking  # noqa: E402

RANKING = ROOT / "data" / "ugg" / "champion_ranking"
DDRAGON = ROOT / "data" / "ddragon"
NOTES = ROOT / "data" / "patchnotes"
LABELS = ROOT / "ground_truth" / "directions"
CDRAGON = ROOT / "data" / "cdragon"
OUT = ROOT / "data" / "panel.sqlite"


def version(patch: str) -> str:
    """`16_9` → `16.9.1`. Data Dragon 과 노트 파일명이 이 형태다."""
    return patch.replace("_", ".") + ".1"


def adjusted_in(patch: str) -> frozenset[str]:
    """그 패치 노트에 나온 챔피언 이름."""
    path = NOTES / f"{version(patch)}.html"
    if not path.exists():
        return frozenset()
    return frozenset(b.champion for b in champion_changes(path.read_bytes()))


def version_short(patch: str) -> str:
    """`13_15` → `13.15`. cdragon 은 빌드 번호를 안 쓴다."""
    return patch.replace("_", ".")


def _merge(a: Direction | None, b: Direction | None) -> Direction | None:
    """두 출처의 판정을 합친다. **반대를 말하면 그것이 `mixed` 다.**

    Data Dragon 은 스탯·쿨다운을, cdragon 은 피해량·계수를 본다. **서로 다른
    것을 보므로 한쪽이 다른 쪽을 이기게 하면 안 된다** — 쿨다운을 줄이면서
    (버프) 피해량도 줄였으면(너프) 실제로는 `mixed` 이고, 손 라벨이 정확히
    그렇게 붙는다(`groundtruth.compare` 의 `extends`).
    """
    if a is None:
        return b
    if b is None:
        return a
    return a if a == b else "mixed"


def directions_in(patch: str, previous: str) -> dict[str, tuple[Direction, str]]:
    """그 패치의 챔피언별 방향. **손 라벨이 기계 판정을 이긴다.**

    기계 판정은 두 출처를 합친 것이다.

        auto    Data Dragon — 스탯 · 쿨다운 · 코스트 · 사거리
        value   CommunityDragon — 피해량 · 계수 (ADR-0005)

    손으로 붙인 라벨은 노트 전체를 읽은 것이라 더 정확하고, 라벨이 쌓일수록
    패널이 좋아진다. 어느 쪽에서 왔는지는 `direction_source` 에 남긴다.

    **cdragon 판정은 손 라벨 241개에 붙여 충돌 0 을 확인하고 넣었다.**
    """
    after = json.loads((DDRAGON / f"{version(patch)}.json").read_bytes())["data"]
    before = json.loads((DDRAGON / f"{version(previous)}.json").read_bytes())["data"]
    standard = standard_champions(after)
    names = {k: v.get("name", k) for k, v in standard.items()}

    grouped: dict[str, list] = {}
    for change in drop_mass_changes(diff_versions(before, after), len(standard)):
        grouped.setdefault(change.champion, []).append(change)

    out: dict[str, tuple[Direction, str]] = {}
    for champion_id, entry in standard.items():
        name = names.get(champion_id, champion_id)
        from_stats = champion_direction(grouped.get(champion_id, []))
        from_values = value_direction(
            field_changes(
                read_champion(CDRAGON, version_short(previous), champion_id.lower()),
                read_champion(CDRAGON, version_short(patch), champion_id.lower()),
                champion_id,
                {s["id"]: s["maxrank"] for s in entry.get("spells", [])},
            )
        )
        merged = _merge(from_stats, from_values)
        if merged is None:
            continue
        source = (
            "both"
            if from_stats and from_values
            else ("auto" if from_stats else "value")
        )
        out[name] = (merged, source)
    for label in read_labels(LABELS / f"{patch}.jsonl"):
        out[label.champion] = (label.direction, "label")
    return out


def main() -> int:
    have = {p.stem for p in RANKING.glob("*.json")}
    rows: list[PanelRow] = []
    # 챔피언별 지난 행. **현재 패치 행은 만든 뒤에 넣는다** — 먼저 넣으면
    # 그 행의 라벨(다음 패치에서 조정됨)이 자기 피처로 들어간다.
    history: dict[int, list[PanelRow]] = {}
    previous: dict[int, PanelRow] | None = None
    previous_patch: str | None = None
    skipped_no_next = 0

    print(f"{'패치':8}{'챔피언':>7}{'조정':>6}{'추세':>6}   다음 패치")
    for i, patch in enumerate(PATCH_SEQUENCE):
        if patch not in have:
            previous, previous_patch = None, None
            continue
        nxt = PATCH_SEQUENCE[i + 1] if i + 1 < len(PATCH_SEQUENCE) else None
        if nxt is None:
            skipped_no_next += 1
            continue  # 라벨을 만들 수 없다 — 예측 지점이 못 된다

        ranking = parse_champion_ranking(
            json.loads((RANKING / f"{patch}.json").read_bytes())
        )
        names = champion_names(
            json.loads((DDRAGON / f"{version(patch)}.json").read_bytes())["data"]
        )
        adjusted = adjusted_in(nxt)

        # 직전 패치가 **바로 앞**일 때만 추세를 붙인다. 사이에 결측이 있으면
        # 「직전 대비」가 아니라 「두세 패치 전 대비」가 된다.
        prior = previous if previous_patch == PATCH_SEQUENCE[i - 1] else None
        made = patch_rows(
            patch,
            ranking,
            names,
            adjusted,
            prior,
            directions=directions_in(nxt, patch),
            history=history,
        )
        for row in made:
            history.setdefault(row.champion_id, []).append(row)
        rows.extend(made)

        n_adj = sum(1 for r in made if r.adjusted_next)
        n_trend = sum(1 for r in made if r.has_trend)
        print(f"{patch:8}{len(made):>7}{n_adj:>6}{n_trend:>6}   {nxt}")

        previous = {r.champion_id: r for r in made}
        previous_patch = patch

    write_panel(OUT, tuple(rows))

    with_history = sum(1 for r in rows if r.history_len > 0)
    by_source = {
        s: sum(1 for r in rows if r.direction_source == s)
        for s in ("label", "both", "auto", "value")
    }
    points = len({r.patch for r in rows})
    trend_points = len({r.patch for r in rows if r.has_trend})
    positives = sum(1 for r in rows if r.adjusted_next)
    print(
        f"\n예측 지점 {points} (추세 가능 {trend_points}) · 행 {len(rows):,} "
        f"· 양성 {positives:,} ({positives / len(rows):.1%})"
    )
    print(
        f"이력 피처 붙은 행 {with_history:,} / {len(rows):,} ({with_history / len(rows):.1%})"
    )
    print(
        f"방향 라벨 {sum(by_source.values()):,} "
        f"(손 {by_source['label']:,} · 둘 다 {by_source['both']:,} "
        f"· Data Dragon {by_source['auto']:,} · cdragon {by_source['value']:,})"
    )
    if skipped_no_next:
        print(f"제외: 마지막 패치 {skipped_no_next}개 — 다음 패치가 없어 라벨이 없다")
    print(f"저장: {OUT.relative_to(ROOT)}  ({OUT.stat().st_size:,} B)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
