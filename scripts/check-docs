#!/usr/bin/env python3
"""README 에 적힌 수치가 실제와 맞는지 본다.

    ./scripts/check-docs

**수치는 반복해서 낡는다.** 테스트 개수는 두 번 어긋났고(214 → 215 → 248),
arm 개수는 26 으로 굳어 있는데 실제는 36 이었다. 커버리지도 92% 로 남아 있었다.
**사람이 기억해서 고치는 것으로는 안 된다.**

`check-rule-docs` 가 두 규칙 문서의 동일성을 강제하듯 이것은 수치를 강제한다.
**pre-commit 에는 안 건다** — `pytest --collect-only` 와 arm 계산이 몇 초 걸려
커밋마다 돌리기엔 무겁다. `pytest`·`mypy` 와 같이 직접 돌린다.
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from lol_balance.arms import direction_arms, target_arms  # noqa: E402
from lol_balance.groundtruth import read_labels  # noqa: E402
from lol_balance.ragjudge import read_judgments  # noqa: E402
from lol_balance.rules import read_rules  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402

README = ROOT / "README.md"
PANEL = ROOT / "data" / "panel.sqlite"
SEED = 20260824
SPLIT = "15_13"


def collected() -> int | None:
    """`pytest` 가 세는 테스트 수. 못 세면 건너뛴다."""
    out = subprocess.run(
        [sys.executable, "-m", "pytest", "--collect-only", "-q"],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    found = re.search(r"^(\d+) tests? collected", out.stdout, re.M)
    return int(found.group(1)) if found else None


def arms() -> int | None:
    """표에 실리는 arm 수. **패널이 있어야 센다** — 없으면 건너뛴다."""
    if not PANEL.exists():
        return None
    rows = read_panel(PANEL)
    if not rows:
        return None
    rules = read_rules(ROOT / "rules" / "proposed.jsonl")
    judgments = read_judgments(ROOT / "ground_truth" / "rag")
    target, _ = target_arms(rows, SPLIT, SEED, rules)
    direction, _ = direction_arms(rows, SPLIT, SEED, rules, judgments)
    return len(target) + len(direction)


def adrs() -> int:
    """`docs/adr/` 의 결정 기록 수. **`README.md` 와 `template.md` 는 안 센다.**"""
    return len(list((ROOT / "docs" / "adr").glob("0*.md")))


def labels() -> int | None:
    """방향 라벨 수. 정답지는 커밋하므로 데이터가 없어도 센다."""
    here = ROOT / "ground_truth" / "directions"
    total = sum(len(read_labels(f)) for f in sorted(here.glob("*.jsonl")))
    return total or None


def rules() -> int | None:
    """밸런스 규칙 수."""
    return len(read_rules(ROOT / "rules" / "proposed.jsonl")) or None


def main() -> int:
    text = README.read_text(encoding="utf-8")
    failed: list[str] = []
    skipped: list[str] = []

    for label, pattern, actual in (
        ("arm 개수", r"(\d+)개 arm", arms()),
        # 배지와 본문 양쪽에 적힌다. **모든 등장을 본다** — 한 곳만 고치고
        # 넘어간 적이 있다(315 가 두 곳, 318 이 한 곳이었다).
        ("테스트 개수", r"테스트[ -](\d+)개", collected()),
        # **셀 수 있는 것은 전부 검사에 건다.** ADR 건수가 7 로 굳어 있는 동안
        # 실제로는 8건이 됐다 — 파일을 세면 되는 것을 사람이 기억하고 있었다.
        ("ADR 건수", r"기술 결정 기록 (\d+)건", adrs()),
        ("규칙 개수", r"밸런스 규칙 (\d+)개", rules()),
        ("라벨 종수", r"방향 라벨 ([\d,]+)종", labels()),
    ):
        found = re.findall(pattern, text)
        if not found:
            failed.append(f"{label}: README 에서 못 찾았다 ({pattern})")
            continue
        if actual is None:
            skipped.append(f"{label}: 셀 수 없어 건너뛴다")
            continue
        seen = {int(x.replace(",", "")) for x in found}
        ok = seen == {actual}
        where = f" ×{len(found)}" if len(found) > 1 else ""
        got = str(actual) if ok else " · ".join(str(v) for v in sorted(seen))
        print(
            f"  {'✅' if ok else '❌'} {label:12}README {got:>9}{where:4}   실제 {actual:5}"
        )
        if not ok:
            failed.append(f"{label}: README {got} ≠ 실제 {actual}")

    for note in skipped:
        print(f"  ⏭  {note}")
    if failed:
        print("\n❌ 어긋난 수치")
        for line in failed:
            print(f"   {line}")
        return 1
    print("\n✅ README 수치가 실제와 맞는다.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
