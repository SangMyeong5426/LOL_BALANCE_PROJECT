#!/usr/bin/env python3
"""Riot API 로 한 패치의 경기를 받는다 — **직접 집계**의 원자료.

**키가 필요하다** — `.env` 의 `RIOT_API_KEY`(개인 키). 근거는
docs/adr/0010-riot-api-direct-aggregation.md. 없어도 기존 결과는 전부 나온다.

    ./scripts/fetch-riot 16_15 --since 2026-07-28 --until 2026-07-31T14:05:23Z --per-region 2500
    ./scripts/fetch-riot 16_18 --since 2026-09-11 --per-region 1500
    ./scripts/fetch-riot 16_18 --since 2026-09-17 --add 300     # 매일 수집
    ./scripts/fetch-riot 16_20 --since 2026-10-06 --add 300 --tail 16_19   # 패치가 바뀌는 날

플랫폼(`kr` · `euw1` · `na1`)마다 따로 돈다. 요청 한도가 권역마다 따로 걸리므로
셋을 동시에 돌리면 세 배 빠르다.

**이어받기가 된다.** `data/riot/<패치>/<플랫폼>.jsonl` 에 이미 있는 경기는 다시
받지 않고, 목표 판수에서 모자란 만큼만 더 받는다. 쓸 수 없던 경기(다른 패치 ·
리메이크 · 창 밖)는 `.skip` 에 적어 다음에도 건너뛴다.

**`--tail` 은 앞 패치의 끝을 받는다.** 패치가 바뀌는 날 창 안은 앞 패치 경기다. 버리지
않고 그 패치 파일에 잇는다 — 받던 패치만, 플랫폼마다 `--add` 판까지(`Tail`).

**이용자를 가리키는 것은 파일에 남지 않는다** — `riot.slim` 이 버린다.
"""

from __future__ import annotations

import argparse
import random
import sys
import threading
import time
from dataclasses import replace
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from lol_balance.config import load_settings  # noqa: E402
from lol_balance.riot import (  # noqa: E402
    ROUTES,
    Match,
    RiotClient,
    RiotError,
    Window,
    collect,
    dumps,
    loads,
)

ROOT = Path(__file__).resolve().parents[1]
OUT = ROOT / "data" / "riot"

_lock = threading.Lock()


def log(line: str) -> None:
    stamp = datetime.now().strftime("%H:%M:%S")
    with _lock:
        print(f"{stamp} {line}", flush=True)


def parse_time(text: str) -> int:
    """`2026-07-28` 이나 `2026-07-31T14:05:23Z` → epoch 초. 시간대가 없으면 UTC."""
    value = datetime.fromisoformat(text.replace("Z", "+00:00"))
    if value.tzinfo is None:
        value = value.replace(tzinfo=UTC)
    return int(value.timestamp())


def iso(seconds: int) -> str:
    return datetime.fromtimestamp(seconds, UTC).strftime("%Y-%m-%d %H:%MZ")


class Tail:
    """창 안에서 만난 **앞 패치** 경기를 그 패치 파일에 마저 받는다.

    패치가 바뀌는 날 창 안은 앞 패치 경기다. 매일 수집은 현재 패치만 받아 그것을 전부
    버렸고, 그래서 패치마다 마지막 날이 비었다 — 2026-10-07 에는 세 플랫폼이 요청
    759 ~ 975회를 쓰고 0판으로 끝났다. `collect` 가 버리기 전에 여기로 넘긴다.

    **받던 패치만 잇는다.** 그 패치 · 플랫폼의 파일에 경기가 있어야 한다. 한 번도 안
    받은 패치의 마지막 날만 받으면 그 하루가 패치 전체처럼 읽힌다.

    **양은 하루치를 넘지 않는다.** 한 실행에 `limit` 판까지다 — 현재 패치와 같은 양이다.

    **이용자 번호는 그 파일의 번호로 다시 매긴다.** 번호는 파일마다 따로 세므로 그대로
    적으면 그 파일의 다른 이용자와 겹친다. 같은 이용자의 경기는 같은 번호를 받는다.

    그 파일은 앞 패치 경기를 **처음 만났을 때** 읽는다. 매일 수집이 날마다 이것을 달고
    돌지만 쓰이는 것은 패치가 바뀌는 며칠뿐이다.
    """

    def __init__(self, patch: str, platform: str, limit: int) -> None:
        self.patch = patch
        self.limit = limit
        self.kept = 0
        self.path = OUT / patch / f"{platform}.jsonl"
        self.seen: set[str] | None = None
        self.next = 1
        self.numbers: dict[int, int] = {}

    def __call__(self, match: Match) -> bool:
        """받았으면 참. 그 패치가 아니거나 · 이미 있거나 · 하루치를 채웠으면 거짓."""
        if match.patch != self.patch or self.kept >= self.limit:
            return False
        if self.seen is None:
            have = (
                [loads(x) for x in self.path.read_text().splitlines() if x.strip()]
                if self.path.exists()
                else []
            )
            self.seen = {m.match_id for m in have}
            self.next = max((m.player for m in have), default=0) + 1
        if not self.seen or match.match_id in self.seen:
            return False
        number = self.numbers.setdefault(match.player, self.next + len(self.numbers))
        with self.path.open("a") as out:
            out.write(dumps(replace(match, player=number)) + "\n")
        self.seen.add(match.match_id)
        self.kept += 1
        return True


def run(
    platform: str,
    window: Window,
    target: int,
    key: str,
    seed: int,
    results: dict[str, str],
    tail: str | None = None,
) -> None:
    folder = OUT / window.patch
    folder.mkdir(parents=True, exist_ok=True)
    data = folder / f"{platform}.jsonl"
    skipped = folder / f"{platform}.skip"

    have = (
        [loads(line) for line in data.read_text().splitlines() if line.strip()]
        if data.exists()
        else []
    )
    seen = {m.match_id for m in have}
    if skipped.exists():
        seen |= {x.strip() for x in skipped.read_text().splitlines() if x.strip()}
    remaining = target - len(have) if target > 0 else -target
    if remaining <= 0:
        results[platform] = f"{len(have):,}판 — 이미 있다"
        log(f"[{platform}] {results[platform]}")
        return

    client = RiotClient(key)
    rng = random.Random(f"{seed}:{window.patch}:{platform}:{len(have)}")
    first = max((m.player for m in have), default=0)
    keep = Tail(tail, platform, remaining) if tail else None
    started = time.monotonic()
    with data.open("a") as out, skipped.open("a") as skip_out:

        def write(m: Match) -> None:
            out.write(dumps(m) + "\n")
            out.flush()

        def skip(match_id: str) -> None:
            skip_out.write(match_id + "\n")
            skip_out.flush()

        try:
            got = collect(
                client,
                platform,
                window,
                remaining,
                seen,
                first,
                rng,
                write,
                skip,
                log,
                other=keep,
            )
        except RiotError as exc:
            results[platform] = f"멈춤 — {exc}"
            log(f"[{platform}] {results[platform]}")
            return
        except Exception as exc:  # noqa: BLE001 — 한 플랫폼이 죽어도 나머지는 계속
            results[platform] = f"멈춤 — 뜻밖의 오류 {type(exc).__name__}: {exc}"
            log(f"[{platform}] {results[platform]}")
            return
    minutes = (time.monotonic() - started) / 60
    also = f" · 앞 패치 {tail} 에 {keep.kept:,}판" if keep and keep.kept else ""
    # **「분」으로 끝나야 한다** — main() 이 그것으로 멈춘 플랫폼을 가른다
    results[platform] = (
        f"{len(have) + got:,}판{also} · 요청 {client.requests:,}"
        f" · 429 {client.throttled}회 · {minutes:.0f}분"
    )
    log(f"[{platform}] 끝 — {results[platform]}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("patch", help="우리 패치 표기 — 예: 16_15")
    parser.add_argument("--since", required=True, help="창 시작(UTC). 출시일 0시")
    parser.add_argument("--until", help="창 끝(UTC). 비우면 지금")
    size = parser.add_mutually_exclusive_group(required=True)
    size.add_argument("--per-region", type=int, help="플랫폼마다 모두 합쳐 이만큼")
    size.add_argument(
        "--add", type=int, help="있는 것과 상관없이 플랫폼마다 더 받을 판수"
    )
    parser.add_argument("--platforms", default=",".join(ROUTES))
    parser.add_argument(
        "--tail",
        metavar="PATCH",
        help="창 안에서 만난 이 패치(앞 패치) 경기를 그 패치 파일에 받는다 — --add 판까지",
    )
    args = parser.parse_args()
    # `--per-region` 은 옛 패치를 창을 적어 받는 길이다. 거기서는 패치를 섞지 않는다
    if args.tail and not args.add:
        parser.error("--tail 은 --add 와 함께 쓴다")
    if args.tail == args.patch:
        parser.error("--tail 에는 받으려는 패치가 아닌 앞 패치를 적는다")

    settings = load_settings()
    if not settings.riot_api_key:
        print("RIOT_API_KEY 가 비어 있다 — .env 에 개인 키를 넣는다 (ADR 0010)")
        return 2
    platforms = [p.strip() for p in args.platforms.split(",") if p.strip()]
    unknown = sorted(set(platforms) - set(ROUTES))
    if unknown:
        print(f"모르는 플랫폼: {unknown} — 쓸 수 있는 것은 {sorted(ROUTES)}")
        return 2

    until = parse_time(args.until) if args.until else int(time.time())
    window = Window(args.patch, parse_time(args.since), until)
    # 음수는 「더 받을 판수」다 — run() 이 둘을 가른다
    target = args.per_region if args.per_region else -args.add
    how = f"{args.per_region:,}판까지" if args.per_region else f"{args.add:,}판 더"
    also = f" · 앞 패치 {args.tail} 의 끝도" if args.tail else ""
    log(
        f"{window.patch} · 창 {iso(window.start)} ~ {iso(window.end)} · "
        f"{' · '.join(platforms)} 에서 {how}{also}"
    )

    results: dict[str, str] = {}
    threads = [
        threading.Thread(
            target=run,
            args=(
                p,
                window,
                target,
                settings.riot_api_key,
                settings.seed,
                results,
                args.tail,
            ),
        )
        for p in platforms
    ]
    for t in threads:
        t.start()
    for t in threads:
        t.join()

    print()
    for p in platforms:
        print(f"  {p:5} {results.get(p, '결과 없음')}")
    stopped = [p for p in platforms if not results.get(p, "멈춤").endswith("분")]
    stopped = [p for p in stopped if "이미 있다" not in results.get(p, "")]
    return 1 if stopped else 0


if __name__ == "__main__":
    sys.exit(main())
