#!/usr/bin/env python3
"""배포 페이지가 읽을 자료 — 정적 API `docs/site/api/v1/` 를 만든다(ADR 0016).

    ./scripts/make-site            만들어 쓴다
    ./scripts/make-site --check    **쓰지 않고** 커밋된 것과 바이트까지 같은지 본다

## 페이지는 이것만 읽는다

응답의 모양과 만드는 법은 `lol_balance.site_api` 한곳에 있다. 페이지는 고르기 ·
정렬 · 글자 꾸미기만 하고 **다시 계산하지 않는다** — 숫자는 전부 여기서 나온다.
쓰기 전에 공개 범위(`16_13`까지)를 검사하고, 넘으면 아무것도 쓰지 않고 멈춘다.

## 근거마다 출처를 남기는 이유

페이지가 보여 주는 것은 「누가 만들었는지 모르는 판단」이다(ADR 0007). 지금은 모델
점수와 규칙이 만들고, **에이전트가 생기면 그것이 만든다** — 모양이 같으므로 페이지는
바뀌지 않고, 둘을 나란히 놓고 비교할 수 있다.

    검색기 셋(R1·R2·R3)  →  맥락  →  판단자  →  후보 · 근거 · 경고  →  페이지
                                        ↑
                            지금: 모델 + 규칙   나중: 에이전트

지금은 `R2`(노트 검색)가 비어 있는데, **에이전트가 채우면 무엇이 늘었는지 화면에서
바로 보인다.**

## 데이터가 있어야 돈다

`data/panel.sqlite` 를 읽는다. 결과는 **커밋한다** — 페이지가 정적으로 돌아야 서버
없이 살아 있기 때문이다. CI 에는 `data/` 가 없으므로 계약 테스트는 커밋된 파일을 본다.

## 다시 만들어도 같아야 한다

`--check` 는 같은 자료로 다시 만든 것이 디스크의 것과 **바이트까지 같은지** 본다. 코드를
고치고 `make-site` 를 안 돌렸거나, 다른 기계에서 값이 달라지면 여기서 걸린다. 쓰지 않으므로
자료를 읽기 전용으로 붙인 컨테이너에서도 돈다([extension 3단계](../docs/extension.md)).
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from lol_balance import site_api  # noqa: E402
from lol_balance.config import load_settings  # noqa: E402
from lol_balance.rules import read_rules  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402

PANEL = ROOT / "data" / "panel.sqlite"
RULES = ROOT / "rules" / "proposed.jsonl"
DDRAGON = ROOT / "data" / "ddragon"
SITE = ROOT / "docs" / "site"
# 페이지가 쓰는 그림. **`docs/site/` 하나로 자족해야** 배포가 단순해진다.
FIGURES = ("lift.svg", "buff-asymmetry.svg")


def korean_names() -> dict[str, str]:
    """영문 표시 이름 → 한글 이름. **없으면 빈 지도를 준다** — 페이지가 영문으로 돈다.

    두 파일을 챔피언 `id` 로 잇는다. 패널이 쓰는 것은 표시 이름(`Nunu & Willump`)
    이라 `id`(`Nunu`)만으로는 못 맞춘다.
    """
    ko = DDRAGON / "ko_KR.json"
    if not ko.exists():
        return {}
    versions = sorted(
        (p for p in DDRAGON.glob("*.json") if p.stem != "ko_KR"),
        key=lambda p: [int(x) for x in p.stem.split(".")],
    )
    if not versions:
        return {}
    english = json.loads(versions[-1].read_text(encoding="utf-8"))["data"]
    korean = json.loads(ko.read_text(encoding="utf-8"))["data"]
    return {
        english[key]["name"]: korean[key]["name"]
        for key in english
        if key in korean and english[key]["name"] != korean[key]["name"]
    }


def main() -> int:
    if {"-h", "--help"} & set(sys.argv):
        print(__doc__)
        return 0
    rows = read_panel(PANEL)
    if not rows:
        print("패널이 비었다. ./scripts/build-panel 을 먼저 돌린다.", file=sys.stderr)
        return 1

    seed = load_settings().seed
    rules = read_rules(RULES) if RULES.exists() else ()
    files = site_api.build(rows, rules, korean_names(), seed)
    if "--check" in sys.argv:
        return check(files)
    written = site_api.write(SITE, files)

    (SITE / "img").mkdir(exist_ok=True)
    for name in FIGURES:
        src = ROOT / "docs" / "img" / name
        if src.exists():
            (SITE / "img" / name).write_bytes(src.read_bytes())

    size = sum(p.stat().st_size for p in written)
    patches = sum(path.startswith("patches/") for path in files)
    champions = sum(path.startswith("champions/") for path in files)
    print(
        f"docs/site/{site_api.API_DIR}/  파일 {len(written)}개 · {size / 1024:,.0f} KB"
    )
    print(f"  패치 {patches}개 · 챔피언 {champions}종")
    return 0


def check(files: dict) -> int:
    """다시 만든 것과 디스크의 것을 견준다. **쓰지 않는다.**"""
    problems = site_api.stale(SITE, files)
    for name in FIGURES:
        src, copy = ROOT / "docs" / "img" / name, SITE / "img" / name
        if src.exists() and not copy.exists():
            problems.append(f"없다: img/{name}")
        elif src.exists() and src.read_bytes() != copy.read_bytes():
            problems.append(f"다르다: img/{name}")
    total = len(site_api.render(files))
    if problems:
        print(
            f"❌ 배포 페이지의 자료가 지금 만들 것과 다르다 — {len(problems)}개 / {total}개"
        )
        for line in problems[:20]:
            print(f"   {line}")
        if len(problems) > 20:
            print(f"   … {len(problems) - 20}개 더")
        print("\n코드나 자료를 고쳤으면 ./scripts/make-site 를 돌려 커밋한다.")
        return 1
    print(
        f"✅ 다시 만들어도 바이트까지 같다 — docs/site/{site_api.API_DIR}/ 파일 {total}개"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
