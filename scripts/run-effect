#!/usr/bin/env python3
"""조정이 의도한 방향으로 갔는지 잰다.

    ./scripts/run-effect

조정된 챔피언의 승률 변화에서 **같은 패치 대조군(조정 안 된 챔피언)의 평균
변화를 뺀다.** 아이템·룬처럼 그 패치에 함께 바뀐 것들이 대조군에도 똑같이
걸리므로 그만큼 상쇄된다.

**측정이지 판정이 아니다.** 「너프했는데 승률이 올랐다」는 적어도 「그러니
이렇게 했어야 한다」는 적지 않는다.
"""

from __future__ import annotations

import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from lol_balance.effect import balance_control, outcomes  # noqa: E402
from lol_balance.explain import PRO_REGULAR  # noqa: E402
from lol_balance.items import LOUD, churn_by_patch  # noqa: E402
from lol_balance.panel import PATCH_SEQUENCE  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402

PANEL = ROOT / "data" / "panel.sqlite"
ITEMS = ROOT / "data" / "items"


def main() -> int:
    rows = read_panel(PANEL)
    by_patch: dict[str, list] = {}
    for row in rows:
        by_patch.setdefault(row.patch, []).append(row)

    # **아이템 변경은 정답지에 없다.** 대조군이 패치 전반의 변화는 흡수하지만
    # 한 챔피언 빌드를 겨냥한 아이템 변경은 못 흡수한다. 어느 챔피언이 그
    # 아이템을 사는지 모르므로 빼지는 못하고, 어느 패치가 그런지만 표시한다.
    churn = churn_by_patch(ITEMS) if ITEMS.is_dir() else {}

    # 챔피언별 **평생 평균** 프로 픽·밴율. 한 패치만 튀는 것과 늘 나오는 것은
    # 다르므로 조정 시점 값이 아니라 평생 값으로 「프로 단골」을 가른다.
    seen: dict[str, list[float]] = {}
    for row in rows:
        if row.pro_presence is not None:
            seen.setdefault(row.champion, []).append(row.pro_presence)
    lifetime = {c: sum(v) / len(v) for c, v in seen.items()}

    found = []
    loud: list[tuple[str, int, int]] = []
    control_closer = control_total = 0
    pairs = 0
    for i in range(len(PATCH_SEQUENCE) - 1):
        a, b = PATCH_SEQUENCE[i], PATCH_SEQUENCE[i + 1]
        if a in by_patch and b in by_patch:
            pairs += 1
            got = outcomes(tuple(by_patch[a]), tuple(by_patch[b]))
            found.extend(got)
            hit, total = balance_control(tuple(by_patch[a]), tuple(by_patch[b]))
            control_closer += hit
            control_total += total
            c = churn.get(b)
            if c and c.finished >= LOUD:
                loud.append((b, c.finished, len(got)))

    if not found:
        print("잴 것이 없다. ./scripts/build-panel 을 먼저 돌린다.")
        return 1

    print(f"인접 패치 쌍 {pairs}개 · 방향이 분명한 조정 {len(found)}건\n")
    print(f"{'':8}{'n':>5}{'원변화':>10}{'대조군 뺀 뒤':>13}{'의도대로':>10}")
    for direction in ("nerf", "buff"):
        part = [o for o in found if o.direction == direction]
        raw = np.array([o.raw_shift for o in part]) * 100
        adj = np.array([o.adjusted_shift for o in part]) * 100
        worked = sum(1 for o in part if o.worked) / len(part)
        print(
            f"{direction:8}{len(part):>5}{raw.mean():>+9.3f}%p"
            f"{adj.mean():>+12.3f}%p{worked:>10.1%}"
        )

    # ③′ **균형에 가까워졌나.** 「의도대로 갔나」와 다른 질문이라 따로 낸다.
    base = control_closer / control_total if control_total else float("nan")
    print(f"\n균형(5할)에 가까워졌나 — 조정 안 된 챔피언은 {base:.1%} 가 가까워진다")
    for direction in ("nerf", "buff"):
        part = [o for o in found if o.direction == direction]
        got = sum(o.closer for o in part) / len(part)
        print(
            f"   {direction:6}{len(part):>5}건   {got:>7.1%}   대조군 대비 {got - base:>+6.1%}p"
        )

    # 프로 경기 비대칭. **%p 가 아니라 자기 값 대비 비율**이라 중앙값으로 본다.
    print(f"\n프로 경기 픽·밴율 변화 (평생 평균 {PRO_REGULAR:.3f} 이상이면 프로 단골)")
    print(f"   {'':22}{'n':>5}{'솔랭 승률':>12}{'프로 픽·밴율':>14}")
    for direction in ("nerf", "buff"):
        for regular in (True, False):
            part = [
                o
                for o in found
                if o.direction == direction
                and o.pro_change is not None
                and (lifetime.get(o.champion, 0.0) >= PRO_REGULAR) is regular
            ]
            if not part:
                continue
            solo = np.median([o.adjusted_shift for o in part]) * 100
            pro = np.median([o.pro_change for o in part])
            label = f"{direction} · {'프로 단골' if regular else '그 외'}"
            print(f"   {label:22}{len(part):>5}{solo:>+11.2f}%p{pro:>+13.1%}")

    every = np.array([o.adjusted_shift for o in found]) * 100
    print("\n효과 크기 분포 (대조군 뺀 뒤, %p)")
    for q in (10, 25, 50, 75, 90):
        print(f"   {q:>3}% 분위  {np.percentile(np.abs(every), q):>6.3f}")

    print("\n라벨 출처별 — 자동 판정은 스탯·쿨다운 조정 쪽으로 치우쳐 있다")
    for source in ("auto", "label"):
        part = [o for o in found if o.source == source]
        if not part:
            continue
        worked = sum(1 for o in part if o.worked) / len(part)
        adj = np.array([o.adjusted_shift for o in part]) * 100
        print(
            f"   {source:6} {len(part):>4}건 · 의도대로 {worked:.1%} · 평균 |효과| {np.abs(adj).mean():.3f}%p"
        )

    if loud:
        share = sum(n for _, _, n in loud) / len(found)
        print(
            f"\n⚠ 아이템이 크게 바뀐 패치 {len(loud)}개 — 이 표의 {share:.0%} 가 여기서 왔다"
        )
        print("   대조군은 패치 전반의 변화만 흡수한다. 한 챔피언 빌드를 겨냥한")
        print("   아이템 변경은 남아서 효과에 섞인다.")
        for patch, finished, n in sorted(loud, key=lambda r: -r[1]):
            print(f"     {patch:7}완성템 {finished:>3}종 · 이 패치의 조정 {n:>3}건")

    print("\n**측정이지 판정이 아니다.** 이 표는 조정이 어느 방향으로 얼마나")
    print("움직였는지만 말한다. 라이엇이 잘했는지는 다루지 않는다.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
