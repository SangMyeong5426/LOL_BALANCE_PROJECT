#!/usr/bin/env python3
"""통계 베이스라인을 돌려 비교표를 만든다.

    ./scripts/run-baselines [--split 15_13]

**LLM 도 API 키도 필요 없다.** 이 표가 나중에 LLM arm 이 넘어야 할 선이다.
못 넘으면 못 넘었다고 적는다.

시간순으로 자른다. 무작위 분할은 미래가 과거로 새어 성적이 가짜로 좋아진다.
"""

from __future__ import annotations

import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from sklearn.linear_model import LogisticRegression  # noqa: E402
from sklearn.neighbors import KNeighborsClassifier  # noqa: E402
from sklearn.pipeline import make_pipeline  # noqa: E402
from sklearn.preprocessing import StandardScaler  # noqa: E402

from lol_balance.baseline import (  # noqa: E402
    encode,
    fit_encoder,
    precision_at,
    r_precision,
    roc_auc,
)
from lol_balance.config import load_settings  # noqa: E402
from lol_balance.panel import patch_index  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402

PANEL = ROOT / "data" / "panel.sqlite"


def arg(flag: str, default: str) -> str:
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv else default


def evaluate(patches, y, score):  # type: ignore[no-untyped-def]
    """패치마다 재고 평균 낸다. 패치가 평가 단위다 — 행이 아니라."""
    rp, p10, auc = [], [], []
    for patch in sorted(set(patches), key=patch_index):
        m = patches == patch
        rp.append(r_precision(y[m], score[m]))
        p10.append(precision_at(y[m], score[m], 10))
        auc.append(roc_auc(y[m], score[m]))
    return (
        float(np.nanmean(rp)),
        float(np.nanmean(p10)),
        float(np.nanmean(auc)),
    )


def main() -> int:
    split = arg("--split", "15_13")
    seed = load_settings().seed
    rows = read_panel(PANEL)
    if not rows:
        print("패널이 비었다. ./scripts/build-panel 을 먼저 돌린다.")
        return 1

    cut = patch_index(split)
    train_rows = tuple(r for r in rows if r.patch_index < cut)
    test_rows = tuple(r for r in rows if r.patch_index >= cut)

    print(f"시드 {seed} · 분할 {split} 앞뒤")
    print(
        f"  학습 {len({r.patch for r in train_rows}):2}패치 {len(train_rows):,}행 "
        f"양성 {sum(r.adjusted_next for r in train_rows):,}"
    )
    print(
        f"  평가 {len({r.patch for r in test_rows}):2}패치 {len(test_rows):,}행 "
        f"양성 {sum(r.adjusted_next for r in test_rows):,}"
    )
    base = sum(r.adjusted_next for r in test_rows) / len(test_rows)
    print(f"  평가 구간 양성 비율(기준선) {base:.1%}\n")

    print(f"{'arm':4}{'방법':34}{'R-정확도':>10}{'P@10':>9}{'AUC':>8}")
    print("-" * 65)

    results = []

    # A0 — 무작위. 시드 고정. AUC 0.5 근처가 나와야 지표가 정상이라는 확인도 된다.
    flat = fit_encoder(train_rows, with_trend=False)
    te = encode(test_rows, flat)
    rng = np.random.default_rng(seed)
    results.append(
        ("A0", "무작위 순서", *evaluate(te.patches, te.y, rng.random(len(te))))
    )

    # A0b — 픽률 순. 「많이 하는 챔피언이 조정된다」는 단순 직관.
    pick = te.x[:, te.columns.index("pick_rate")]
    results.append(("A0b", "픽률 높은 순", *evaluate(te.patches, te.y, pick)))

    # A0c — 승률 순. 단조롭지 않아서 무작위보다 못하다.
    win = te.x[:, te.columns.index("win_rate")]
    results.append(("A0c", "승률 높은 순", *evaluate(te.patches, te.y, win)))

    # A0d — 5할에서 먼 순. 같은 승률 정보인데 단조로 바꾸면 이렇게 달라진다.
    gap = te.x[:, te.columns.index("wr_gap")]
    results.append(("A0d", "|승률 − 0.5| 큰 순", *evaluate(te.patches, te.y, gap)))

    for name, label, trend in (
        ("A1", "로지스틱 회귀 — 수준 피처", False),
        ("A2", "로지스틱 회귀 — 수준 + 추세", True),
    ):
        enc = fit_encoder(train_rows, with_trend=trend)
        tr, te = encode(train_rows, enc), encode(test_rows, enc)
        model = make_pipeline(
            StandardScaler(),
            LogisticRegression(
                max_iter=2000, class_weight="balanced", random_state=seed
            ),
        )
        model.fit(tr.x, tr.y)
        results.append(
            (name, label, *evaluate(te.patches, te.y, model.predict_proba(te.x)[:, 1]))
        )

    # A3 — 유사 사례. RAG 의 검색부만 떼어 낸 것이다.
    tr, te = encode(train_rows, flat), encode(test_rows, flat)
    knn = make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=50))
    knn.fit(tr.x, tr.y)
    results.append(
        (
            "A3",
            "유사 사례 50개 (k-NN)",
            *evaluate(te.patches, te.y, knn.predict_proba(te.x)[:, 1]),
        )
    )

    for name, label, rp, p10, auc in results:
        print(f"{name:4}{label:34}{rp:>9.1%}{p10:>9.1%}{auc:>8.3f}")

    print(f"\nR-정확도: 실제 조정된 수만큼 뽑았을 때 맞힌 비율. 기준선 {base:.1%}")
    print("P@10   : 상위 10종 중 맞힌 비율")
    print("AUC    : 0.5 면 무작위, 1.0 이면 완벽")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
