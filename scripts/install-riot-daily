#!/usr/bin/env python3
"""직접 집계를 매일 쌓는 예약 작업을 이 맥에 걸거나 뗀다.

    ./scripts/install-riot-daily              # 매시간 확인 · 맥이 깨어 있을 때 하루 한 번
    ./scripts/install-riot-daily --uninstall  # 떼기

macOS launchd 의 사용자 작업(`~/Library/LaunchAgents`)으로 건다. 시스템 설정은
건드리지 않는다.

**시각이 아니라 간격으로 건다.** 예전에는 매일 05:10 이었는데, 덮개를 닫은 맥은
그 시각에 제대로 깨지 못하고 몇 초씩만 깬다(다크웨이크). 그래서 매시간
`fetch-riot-daily --scheduled` 를 부르고, 그쪽이 「마지막으로 받은 지 20시간이
지났나 · 맥이 깨어 있나」를 보고 하루 한 번만 돈다. 건너뛸 때는 요청을 보내지 않는다.

기록은 `data/logs/riot-daily.log` 에 쌓인다. 키가 거절되면(개발 키는 24시간마다
꺼진다) 거기 「거절됐다」가 남는다.
"""

from __future__ import annotations

import argparse
import plistlib
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
LABEL = "com.lolbalance.riot-daily"
PLIST = Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"
LOG = ROOT / "data" / "logs" / "riot-daily.log"
# 맥을 연 뒤 이 안에 돈다. 확인은 파일 시각과 `pmset` 한 번이라 거의 공짜다
CHECK_EVERY_MINUTES = 60


def job() -> dict[str, object]:
    # launchd 의 PATH 에는 가상환경이 없다 — 파이썬을 경로로 박는다
    command = (
        f"cd '{ROOT}' && ./.venv/bin/python scripts/fetch-riot-daily --scheduled"
        f" >> '{LOG}' 2>&1"
    )
    return {
        "Label": LABEL,
        "ProgramArguments": ["/bin/sh", "-c", command],
        "StartInterval": CHECK_EVERY_MINUTES * 60,
        # 로그인할 때도 한 번 본다 — 이미 받았으면 요청 없이 그냥 끝난다
        "RunAtLoad": True,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--uninstall", action="store_true")
    args = parser.parse_args()

    if PLIST.exists():
        subprocess.run(["launchctl", "unload", str(PLIST)], check=False)
    if args.uninstall:
        PLIST.unlink(missing_ok=True)
        print(f"뗐다: {PLIST}")
        return 0

    LOG.parent.mkdir(parents=True, exist_ok=True)
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    PLIST.write_bytes(plistlib.dumps(job()))
    subprocess.run(["launchctl", "load", str(PLIST)], check=True)
    print(
        f"걸었다: {CHECK_EVERY_MINUTES}분마다 확인 · 맥이 깨어 있을 때 하루 한 번 돈다"
        f" · {PLIST}"
    )
    print(f"기록: {LOG}")
    print("떼려면: ./scripts/install-riot-daily --uninstall")
    return 0


if __name__ == "__main__":
    sys.exit(main())
