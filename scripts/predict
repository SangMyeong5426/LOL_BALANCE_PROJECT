#!/usr/bin/env python3
"""다음 패치에 무엇이 조정될지 예측한다. **백테스트가 아니라 실제 예측이다.**

    ./scripts/predict [--patch 16_13] [--top 5] [--score]

`run-report` 는 과거를 되짚어 성적을 재는 도구다. 이것은 **한 패치를 놓고 그
다음 패치를 예측**한다 — 저장소가 실제로 무엇을 하는지가 여기서 보인다.

## 방향으로만 묻는다 — 「조정되나」는 안 낸다

**질문을 좁히는 것이 이 도구에서 유일하게 크게 듣는 지렛대다.** 모델 쪽은 다섯
번 밀어 봤고 전부 실패했다([results](../docs/results/README.md)). 남은 것은
무엇을 묻느냐인데, 재 보니 이만큼 갈린다.

    무엇을 보나        상위5     기준선     배수
    조정 후보         40.0%    14.7%     2.7배   ← 안 낸다
    너프 후보         24.2%     3.4%     7.2배
    버프 후보         14.7%     3.6%     4.1배

**조정 후보의 정밀도가 더 높은데 배수는 제일 낮다.** 「누가 조정될까」는 아무나
찍어도 어느 정도 맞아서다(기준선 14.7%). 도구가 값을 하는 자리는 **찍어서는
거의 안 맞는 질문**이고, 그것이 방향이다.

프로 픽·밴율의 신호가 방향에 따라 반대인 것도 같은 이야기다 — 너프 쪽 AUC
0.658 · 버프 쪽 0.473 이라 합치면 상쇄된다.

`--top` 기본은 **5** 다. 3 이 정밀도는 더 높지만(너프 31.6% · 9.4배) 맞는 수가
1.0 종이라 목록이라기엔 얇다.

## 학습은 예측 대상 패치 이전까지만 쓴다

`--patch 16_13` 이면 `16_13` **이전** 행으로만 학습한다. 그 패치 자신도 안
쓴다 — 그 행의 라벨이 곧 정답이기 때문이다.

## `--score` 는 답을 이미 아는 경우에만 쓴다

패널에 있는 패치면 실제 결과가 라벨로 들어 있으므로 바로 채점된다.

## 아직 답이 없는 패치도 예측한다

**패널은 마지막 패치를 뺀다** — 다음 패치 노트가 없으면 전 챔피언이 「조정 안
됨」으로 라벨이 붙어 조용히 틀리기 때문이다. 그 제외는 맞지만, 그러면 우리가
가진 가장 최근 패치에서 다음을 예측할 수가 없다.

그래서 그 경우 **행을 그 자리에서 만든다**(`assemble.forecast_rows`). 라벨은
안 읽고 `--score` 도 거절한다 — 맞춰 볼 답이 없기 때문이다.

    ./scripts/predict                  가장 최근 패치에서 다음을 예측한다
    ./scripts/predict --patch 16_12    답이 있는 패치. --score 로 채점된다
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from lol_balance.arms import rank_candidates  # noqa: E402
from lol_balance.assemble import forecast_rows  # noqa: E402
from lol_balance.baseline import direction_rows  # noqa: E402
from lol_balance.config import load_settings  # noqa: E402
from lol_balance.explain import (  # noqa: E402
    outcome,
    patch_notes,
    reasons,
    sample_note,
)
from lol_balance.items import churn_by_patch  # noqa: E402
from lol_balance.oracle import read_pro  # noqa: E402
from lol_balance.panel import (  # noqa: E402
    PATCH_SEQUENCE,
    PanelRow,
    as_patch,
    name_after,
    next_patch,
    patch_index,
    settled_patch,
)
from lol_balance.retrieval import CaseSearch  # noqa: E402
from lol_balance.rules import read_rules  # noqa: E402
from lol_balance.store import read_panel  # noqa: E402
from lol_balance.ugg import parse_champion_ranking  # noqa: E402

PANEL = ROOT / "data" / "panel.sqlite"
RANKING = ROOT / "data" / "ugg" / "champion_ranking"
DDRAGON = ROOT / "data" / "ddragon"
ORACLE = ROOT / "data" / "oracle"
ITEMS = ROOT / "data" / "items"
RULES = ROOT / "rules" / "proposed.jsonl"

# 예측 셋. 이름·좁힐 방향·프로 피처를 쓸지.
# 예측 둘. 이름·좁힐 방향·프로 피처를 쓸지.
#
# **「조정되나」는 뺐다.** 정밀도는 더 높은데 기준선도 높아(14.7%) 배수가 제일
# 낮다 — 상위5에서 조정 2.7배 · 너프 7.2배 · 버프 4.1배다. 셋을 나란히 내면
# 제일 안 쓸모 있는 것이 맨 위에 온다.
VIEWS = (
    ("너프 후보", "nerf", True),
    ("버프 후보", "buff", True),
)


def games_in(patch: str) -> int | None:
    """그 패치 스냅샷이 담은 총 게임 수. 파일이 없으면 모른다."""
    path = RANKING / f"{patch}.json"
    if not path.exists():
        return None
    try:
        return int(parse_champion_ranking(json.loads(path.read_text())).games)
    except (ValueError, KeyError):
        return None


def latest_usable(rows: tuple[PanelRow, ...]) -> str:
    """예측할 수 있는 가장 최근 패치. **지표가 굳은 것 중에서 고른다.**

    패널의 끝이 아니라 지표가 있는 끝이다 — 패널은 라벨을 못 만드는 마지막
    패치를 빼므로, 그것까지 보려면 수집한 파일을 봐야 한다. 고르는 규칙은
    `panel.settled_patch` 에 있다(테스트가 거기 붙는다).
    """
    have = {p.stem for p in RANKING.glob("*.json")} if RANKING.is_dir() else set()
    if not have:
        return max({r.patch for r in rows}, key=patch_index)
    return settled_patch({p: games_in(p) for p in have}) or max(have, key=patch_index)


def arg(flag: str, default: str) -> str:
    return sys.argv[sys.argv.index(flag) + 1] if flag in sys.argv else default


def lifetime_pro(rows: tuple[PanelRow, ...]) -> dict[str, float]:
    """챔피언별 **통산** 프로 픽·밴율.

    한 패치 값이 아니라 통산 값으로 「프로 경기에 자주 나오는가」를 본다 — 한 패치만 튀는
    것과 늘 나오는 것은 다르다.
    """
    seen: dict[str, list[float]] = {}
    for r in rows:
        if r.pro_presence is not None:
            seen.setdefault(r.champion, []).append(r.pro_presence)
    return {c: sum(v) / len(v) for c, v in seen.items() if len(v) >= 20}


def main() -> int:
    at = as_patch(arg("--patch", ""))
    top = int(arg("--top", "5"))
    seed = load_settings().seed
    rows = read_panel(PANEL)
    if not rows:
        print("패널이 비었다. ./scripts/build-panel 을 먼저 돌린다.", file=sys.stderr)
        return 1

    if not at:
        at = latest_usable(rows)
    if at not in PATCH_SEQUENCE:
        print(
            f"{at} 은 아는 패치가 아니다. {PATCH_SEQUENCE[0]} ~ {PATCH_SEQUENCE[-1]}",
            file=sys.stderr,
        )
        if at.count("_") > 1:
            print(
                "  세 자리는 Data Dragon 표기다. 패치는 두 자리로 쓴다 — 16_15 · 16.15 둘 다 된다",
                file=sys.stderr,
            )
        return 2

    forecast = at not in {r.patch for r in rows}
    nxt = next_patch(at) or (name_after(at) if forecast else None)
    if nxt is None:
        print(f"{at} 이 패치 순서의 끝이라 다음 패치가 없다.", file=sys.stderr)
        return 2

    # **패널에 없어도 지표가 있으면 예측한다.** 패널은 마지막 패치를 빼는데,
    # 다음 패치 노트가 없으면 라벨이 조용히 틀리기 때문이다. 그 제외는 맞지만
    # 그러면 가장 최근 패치에서 다음을 예측할 수가 없다. 여기서 따로 만든다 —
    # **라벨은 안 읽고, 채점도 막는다.**
    if forecast:
        if not (RANKING / f"{at}.json").exists():
            print(f"패널에도 없고 {RANKING.name}/{at}.json 도 없다.", file=sys.stderr)
            return 2
        test = forecast_rows(
            at,
            rows,
            ranking=RANKING,
            ddragon=DDRAGON,
            pro=read_pro(ORACLE) if ORACLE.is_dir() else None,
        )
    else:
        test = tuple(r for r in rows if r.patch == at)

    train = tuple(r for r in rows if r.patch_index < patch_index(at))
    scored = "--score" in sys.argv

    print(f"{at} 지표로 {nxt} 패치를 예측한다")
    print(
        f"  학습 {len(train):,}행 "
        # **문자열 최대값이 아니다.** `16_9` 가 `16_13` 보다 크게 나온다 —
        # 저장소가 「버전 표기를 믿지 않는다」고 적어 둔 바로 그 함정이다.
        f"(~{max((r.patch for r in train), key=patch_index)}) · 대상 {len(test)}종"
    )
    if forecast:
        print("  ⚠ 아직 답이 없는 패치다 — 진짜 예측이고 채점할 수 없다")
        if scored:
            print("     --score 는 무시한다", file=sys.stderr)
        scored = False
    elif scored and not sum(r.adjusted_next for r in test):
        print("  ⚠ 이 패치에는 라벨이 없다 — 채점할 수 없다", file=sys.stderr)
        scored = False

    rules = read_rules(RULES)
    search = CaseSearch(direction_rows(rows), at)
    pro = lifetime_pro(rows)

    # **패치 전체에 붙는 경고는 머리말에 한 번만 낸다.** 챔피언마다 띄우면 그
    # 패치의 후보 목록 전체에 붙어 「항상 뜨는 경고」가 된다.
    churn = churn_by_patch(ITEMS).get(nxt) if ITEMS.is_dir() else None
    notes = list(patch_notes(churn))

    # **지표가 아직 안 굳은 패치인지 같이 낸다.** 아카이브가 패치마다 다른
    # 시각에 긁혀서, 어떤 패치는 출시 직후 값만 남아 있다. 고칠 방법이 없으므로
    # (`16_15` 는 스냅샷이 하나뿐이다) 적어서 낸다.
    recent = sorted(
        (sum(r.matches for r in rows if r.patch == p) for p in PATCH_SEQUENCE[-8:]),
        reverse=True,
    )
    typical = next((v for v in recent if v), None)
    notes += sample_note(sum(r.matches for r in test), typical)

    for note in notes:
        print(f"  ⚠ {note.text}")

    for label, want, with_pro in VIEWS:
        score = rank_candidates(train, test, want=want, with_pro=with_pro, seed=seed)
        order = np.argsort(-score)[:top]
        print(f"\n=== {label} 상위 {top} ===")

        for i, j in enumerate(order, 1):
            r = test[j]
            line = f"  {i:2} {r.champion:14}점수 {score[j]:.2f}"
            if scored:
                got = outcome(r)
                want_kr = {"nerf": "너프", "buff": "버프"}.get(want or "", "")
                mark = (
                    "✅"
                    if (got == want_kr or (want is None and r.adjusted_next))
                    else "  "
                )
                line += f"   {mark} 실제 {got}"
            print(line)
            # **순위만으로는 도구가 안 된다.** 왜 그런지와 주의할 점을 붙인다.
            notes = reasons(
                r, test, search.similar(r, k=25), rules, pro.get(r.champion), want
            )
            for k, note in enumerate(notes):
                tip = "└" if k == len(notes) - 1 else "├"
                flag = "⚠ " if note.warn else ""
                print(f"      {tip} {flag}{note.text}")
        if scored:
            hits = sum(
                1
                for j in order
                if (
                    test[j].adjusted_next
                    if want is None
                    else test[j].direction_next == want
                )
            )
            print(f"  → 상위 {top} 중 적중 {hits}종")

    if not scored:
        print(
            f"\n실제 {nxt} 패치 노트와 대조하려면 그 노트를 받은 뒤 --score 를 붙인다."
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
